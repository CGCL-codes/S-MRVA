# VCS / agent tooling — never ship these (top-level and nested)
.git
.gitignore
.claude
.claudeignore
.agents
.agent
.opencode
**/.git
**/.gitignore
**/.claude
**/.claudeignore
**/.agents
**/.agent
**/.opencode

# Python
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
.pytest_cache/
**/.pytest_cache/

# Secrets
.env
.env.*
!*.example

